<script>
// Add an OS tooltip to count the number of days since the last game was played
document.addEventListener('DOMContentLoaded', () => {
    const lastGameDate = document.querySelector('#u2-last-game-date time');
    if (!lastGameDate || typeof Temporal === 'undefined') { return; }
    const startingPoint = Temporal.PlainDate.from(lastGameDate.getAttribute('datetime'));
    const todaysDate = Temporal.PlainDate.from(new Date().toISOString().split('T').shift());
    let daysSince = todaysDate.since(startingPoint, { smallestIncrement: 'days', roundingIncrement: 1, roundingMode: 'floor' }).total('days');
    if (Intl) { daysSince = new Intl.NumberFormat('en-US').format(daysSince); }
    lastGameDate.setAttribute('title', `${daysSince} days ago`);
});
</script>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 113 38" width="113" height="38" aria-hidden="true">
			<defs>
				<filter id="inner-highlight"><feOffset dx="0" dy="1.5"></feOffset>
					<feMorphology operator="dilate" radius="2"></feMorphology>
					<feGaussianBlur stdDeviation="1" result="offset-blur"></feGaussianBlur>
					<feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse"></feComposite>
					<feFlood flood-color="white" result="color" flood-opacity=".5"></feFlood>
					<feComposite operator="in" in="color" in2="inverse" result="highlight"></feComposite>
					<feComposite operator="over" in="highlight" in2="SourceGraphic"></feComposite>
				</filter>
			</defs>

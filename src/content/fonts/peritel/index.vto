---js
{
	layout: 'font-specimen.vto',
	title: 'Peritel',
	summary: 'A nostalgia-fuelled retro typeface',
	fontLove: 'electron beams',
	styleOverrides: ['peritel'],
	customMetaImage: 'peritel.jpg', // Base photo by molvin: https://unsplash.com/photos/a-white-rectangular-object-with-a-screen-E1ZWQdhHO1w
	fontSpecimen: { 'Peritel': [{
		'file': '/assets/fonts/Peritel-Regular.woff2',
	}]},
	fontPrice: 8,
	fontDirectoryOrder: -1,
	fontSpecimenSampleDefault: 'Electron beams',
	fontSpecimenFallback: 'sans-serif',
	fontPreventPreviewDownload: true,
	fontMetrics: {
		emSize: 1000,
		capHeight: 639,
		xHeight: 458,
		ascender: 639,
		descender: -180,
	},
	fontPurchaseLink: 'https://buymeacoffee.com/chriskirknielsen/e/562657',
	setsList: {
		ss01: { name: 'Single-storey a', glyphs: 'aāàáâãäå' },
		ss02: { name: 'Straightened r', glyphs: 'r' },
		ss03: { name: 'Curvy y', glyphs: 'yýÿŷỳ' },
		ss04: { name: 'Barred G', glyphs: 'G' },
		ss05: { name: 'Serif I', glyphs: 'IÍÎÏÌĪ' },
		ss06: { name: 'Taller P+R', glyphs: 'PR' },
		ss07: { name: 'Restyled 3+4', glyphs: '34' },
		ss08: { name: 'Smaller @+®', glyphs: '@®' },
		liga: { name: 'Standard Ligatures', glyphs: ['fa', 'fi', 'fl', 'ra', 'ri', 'rt', 'st', 'ts', 'tt'] },
		dlig: { name: 'Discretionary Ligatures', glyphs: ['(SELECT)', '(START)'] },
		tnum: { name: 'Tabular Figures', glyphs: '0123456789' },
	},
	eleventyComputed: {
		fontSpecimenNav: function (data) {
			return {
				'#test': 'Test Drive',
				'#glyphs': 'Glyphs',
				'#features': 'Features',
				[data.fontPurchaseLink]: 'Buy'
			};
		}
	},
}
---


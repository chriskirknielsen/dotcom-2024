{{ set initialGlyph = 'A' }}
{{ set initialGlyphCode = initialGlyph |> toCharCode }}
{{ set initialGlyphName = unicodeMapping[initialGlyphCode] }}
{{ function glyphGroup(name, glyphs, isOpen, features) }}
	{{ set count = glyphs.length }}
	<details class="expander"{{ isOpen ? ' open' : '' }}>
		<summary class="expander-button"><span class="expander-button-inner"><span class="expander-button-text">{{ name }} &times; {{ count }}</span></span></summary>
		<div class="expander-content">
			<p class="demo-grid-multi specimen-set-demo demo-grid specimen">
				{{ for char of glyphs.split('') }}
					{{- set charCodePoint = char |> toCharCode -}}
					{{- set charUnicodeName = unicodeMapping[charCodePoint] -}}
					<span class="glyph fancy-button" data-base-class="" data-glyph-code="{{ charCodePoint }}" data-glyph-name="{{ charUnicodeName }}" title="{{ charUnicodeName }}">
						<span>{{ char |> escape }}</span>
					</span>
				{{ /for }}
			</p>
		</div>
	</details>
{{ /function }}

<div class="main-heading-block fullbleed">
	<h1 class="visually-hidden">{{ title }}</h1>

	<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="860" height="240"  viewBox="0 0 860 240" class="main-heading-vector" aria-hidden="true">
		<defs>
			<symbol id="font-outline" width="860" height="240" viewBox="0 0 860 240">
				<path d="M39.41 30.36h87.41c31.63 0 44.75 22.98 44.75 51.17 0 28.04-13.12 50.71-44.75 50.71H84.76v76.97H39.4zm76.08 75.78c6.4 0 11.78-5.37 11.78-12.53V68.25a11.93 11.93 0 0 0-11.93-12.38H84.76v50.27zm61.9 41.32v-4.77c0-34.31 13.42-61.61 45.35-61.61h43.7c19.84 0 35.8 16.86 35.8 37.89v38.78h-79.5v13.43c0 7 5.22 12.68 11.63 12.68h45.2v25.2h-56.68c-32.22 0-45.5-27.44-45.5-61.6m80.55-15.22v-12.97c0-7.16-5.52-13.13-12.08-13.13h-10.9c-6.85 0-12.22 5.97-12.22 13.13v12.97zm61.9-51.16h76.08c31.77 0 45.05 27.6 45.05 61.6h-45.2v-23.86a11.93 11.93 0 0 0-11.93-12.68h-18.8v103.07h-45.2zm137.24-50.72h45.2v25.36h-45.2zm0 50.72h45.2v127.99h-45.2zm66.82 66.38V30.2h45.2v50.72h29.39V106h-29.24v65.04c0 7 5.07 12.68 11.93 12.68h23.87v25.2h-35.8c-32.07 0-45.2-27.44-45.2-61.6m90.55 0v-4.77c0-34.31 13.42-61.6 45.5-61.6h43.7c19.69 0 35.8 16.85 35.8 37.88v38.78h-79.5v13.43c0 7 5.06 12.68 11.63 12.68h45.2v25.2h-56.84c-32.07 0-45.5-27.44-45.5-61.6m80.7-15.21v-12.98c0-7.16-5.51-13.13-12.23-13.13h-10.74c-6.86 0-12.23 5.97-12.23 13.13v12.98zm62.2 15.21V30.21h45.2v140.82c0 7 5.23 12.68 11.94 12.68h5.82v25.2H802.7c-32.07 0-45.2-27.44-45.2-61.6"/>
			</symbol>
		</defs>
		<use xlink:href="#font-outline" fill="currentColor"></use>
	</svg>
	
	<div class="main-heading-deco" data-shaded="medium">

{{ set fontPangrams = [
	'The quick brown fox jumps over the lazy dog.',
	'Sphinx of black quartz, judge my vow!',
	'Portez ce vieux whisky au juge blond qui fume.',
	'Pack my bag with five dozen liquor jugs.',
	'When juxtaposition yields formidable victories, geeks are quite zen.',
	'Many bespectacled quixotic wizards love frog hijinks.',
	'Brand new CRTs provide quality & fix jank with 50Hz images!',
	'By Zeus! Your very quick brew just fixed my aching temples.',
	'Jake was thoroughly piqued by museum’s voxel zone facts.',
	'A flummoxed jockey’s brave unicorn requested warm gazpacho.',
] }}

<div class="full content freetype" id="test">
	<div class="freetype-specimen">
		<label for="test-editor" class="freetype-label"><span class="specimen" aria-hidden="true">&darr;</span> Test Drive <span class="specimen" aria-hidden="true">&darr;</span></label>
		<div class="freetype-input-wrapper"><textarea class="specimen freetype-input" data-features="" placeholder="Type your text here" spellcheck="false" id="test-editor">{{ fontSpecimenSampleDefault }}</textarea></div>
	</div>

	<div class="freetype-options-wrapper">
		<div class="freetype-options">
			<div class="freetype-option-nojs"><p>Sorry! JavaScript is required to enable interactive font feature testing.</p></div>

			<div class="freetype-option-group" data-group-flow="column" data-group-grow="false">
				<label for="freetype-slider-size" class="freetype-option-group-label">
					Size
				</label>
				<div class="freetype-option-group-items">
					<div class="freetype-option-slider-wrap">
						<input id="freetype-slider-size" type="range" value="52" min="16" max="88" step="1" class="freetype-option-slider" data-freetype-slider="size">
					</div>
				</div>
			</div>

			<div class="freetype-option-group" data-group-flow="row">
				<div class="freetype-option-group-label">
					Style
				</div>
				<div class="freetype-option-group-items">
				{{ for setKey, setInfo of setsList }}
					<div class="freetype-option-group-item-linked">
						<button class="toggle-button freetype-option-group-item-button" type="button" aria-pressed="false" data-freetype-toggle="{{ setKey }}">
							<span class="toggle-button-label" aria-hidden="true">{{ setKey }}</span>
							<span class="visually-hidden">{{ setInfo.name }}</span>
						</button>
						<span class="freetype-option-group-item-label" aria-hidden="true">{{ setInfo.name }}</span>
					</div>
				{{ /for }}
				</div>
			</div>

			<div class="freetype-option-group" data-group-flow="column">
				<div class="freetype-option-group-label">
					Cast
				</div>

				<div class="freetype-option-group-items">
					<button type="button" class="fancy-button" data-freetype-trigger="pangram">
						<span>Pangram</span>
					</button>
					<button type="button" class="fancy-button" data-freetype-trigger="designs">
						<span>Features</span>
					</button>
					<button type="button" class="fancy-button" data-freetype-trigger="uppercase">
						<span><span class="visually-hidden">Transform current text to</span> Uppercase</span>
					</button>
					<button type="button" class="fancy-button" data-freetype-trigger="lowercase">
						<span><span class="visually-hidden">Transform current text to</span> Lowercase</span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<div class="freetype-deco shaded" data-shaded="high" aria-hidden="true"></div>
</div>

<div class="content-split">
	<p>Long before the HD generation, gaming consoles and personal computers had a very distinct style. It was contemporarily futuristic, blending sharp edges with rounded angles, and plastic surfaces with wooden textures. Nostalgia for this aesthetic led to the creation of <strong>Peritel</strong>. The name comes from the “<em lang="fr">prise Péritel</em>” standard (also known as <a href="https://en.wikipedia.org/wiki/SCART">SCART</a>), a 21-pin connector I used a lot growing up to play video games on various televisions. This typeface embodies the identity I picture in my mind when I think of this era of electronics.</p>

	<div class="flow">
		<ul>
			<li><a href="#license">Straightforward licencing</a></li>
			<li>Personal &amp; commercial</li>
			<li>OTF &amp; WOFF2 provided</li>
		</ul>
		<p>
			<a href="{{ fontPurchaseLink }}" class="fancy-button buy-button specimen"><span>Buy Peritel for $8</span></a>
		</p>
	</div>
</div>

<div class="glyph-split color-alt bg-alt fullbleed" id="glyphs">
	<div
		class="glyph-detail specimen shaded"
		data-code-point="{{ initialGlyphCode }}"
		data-glyph-name="{{ initialGlyphName }}"
		data-transition-event="ckn:fontDetailChanged"
		hidden
	>
		{{ set fontSize = 20 }}
		{{ set noteSize = 0.75 }}
		{{ set baseLine = 21 }}
		{{ set lineThickness = 0.05 }}
		{{ set xHeight = baseLine - (fontMetrics.xHeight / fontMetrics.emSize * fontSize) }}
		{{ set capHeight = baseLine - (fontMetrics.capHeight / fontMetrics.emSize * fontSize) }}
		{{ set descender = baseLine - (fontMetrics.descender / fontMetrics.emSize * fontSize) }}
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 30" class="glyph-detail-viewer" aria-hidden="true">
			<defs>
				<clipPath id="screen4x3">
					<path d="M39.7 3.12c-.11-1.48-.57-2.37-1.96-2.66C36.36.16 30.12 0 20 0S3.64.16 2.26.46C.87.76.4 1.64.3 3.12.3 3.12 0 6.91 0 15s.3 11.88.3 11.88c.11 1.48.57 2.37 1.96 2.66 1.38.3 7.62.46 17.74.46s16.36-.16 17.74-.46 1.85-1.18 1.95-2.66c0 0 .31-3.79.31-11.88s-.3-11.88-.3-11.88" />
				</clipPath>
				<radialGradient id="screen-main-grad" cx="50%" cy="95%" r="98%" fx="50%" fy="15%">
					<stop offset="0" stop-color="#421416"/>
					<stop offset="0.99" stop-color="#220708"/>
				</radialGradient>
			</defs>
			<g clip-path="url(#screen4x3)">
				<rect class="glyph-detail-bg" width="100%" height="100%" />
				<rect fill="url(#screen-main-grad)" width="100%" height="100%" />
				
				<line x1="0" x2="100%" y1="{{ baseLine }}" y2="{{ baseLine }}" class="glyph-detail-line" stroke-width="{{ lineThickness }}" />
				<text class="glyph-detail-info" text-anchor="end" font-size="{{ noteSize }}" x="99%" y="{{ baseLine - 0.5 }}">BASELINE</text>

				<line x1="0" x2="100%" y1="{{ xHeight + lineThickness }}" y2="{{ xHeight + lineThickness }}" class="glyph-detail-line" stroke-width="{{ lineThickness }}" />
				<text class="glyph-detail-info" text-anchor="end" font-size="{{ noteSize }}" x="99%" y="{{ xHeight - 0.5 }}">X-HEIGHT</text>

				<line x1="0" x2="100%" y1="{{ capHeight + lineThickness }}" y2="{{ capHeight + lineThickness }}" class="glyph-detail-line" stroke-width="{{ lineThickness }}" />
				<text class="glyph-detail-info" text-anchor="end" font-size="{{ noteSize }}" x="99%" y="{{ capHeight - 0.5 }}">CAP HEIGHT</text>

				<line x1="0" x2="100%" y1="{{ descender }}" y2="{{ descender }}" class="glyph-detail-line" stroke-width="{{ lineThickness }}" />

				<text class="glyph-detail-inner" text-anchor="middle" font-size="{{ fontSize }}" x="50%" y="{{ baseLine }}">{{ initialGlyph }}</text>

				<text class="glyph-detail-code | glyph-detail-info" text-anchor="middle" font-size="{{ noteSize }}" x="50%" y="2">U+{{ initialGlyphCode }}</text>
				<text class="glyph-detail-name | glyph-detail-info" text-anchor="middle" font-size="{{ noteSize }}" x="50%" y="28">{{ initialGlyphName }}</text>
			</g>
		</svg>
	</div>
	<div class="glyph-list flow shaded" data-shaded="medium">
		{{ glyphGroup('Basic Latin', 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz', true) }}
		{{ glyphGroup('Latin Supplement', 'ÁÂÄÀĀÅÃÆÇÐĐÉÊËÈĒĲÍÎÏÌĪŁÑÓÔÖÒŌØÕŒÞÚÛÜÙŪẂŴẄẀÝŶŸỲáâäàāåãæçðďđéêëèēíîïìĳīłñóôöòōøõœþßúûüùūẃŵẅẁýŷÿỳ¨˙`´ˆˇ˚˜¯¸', false) }}
		{{ glyphGroup('Numbers', '0123456789', true) }}
		{{ glyphGroup('Greek', 'ΔΠΣΩβμπ', false) }}
		{{ glyphGroup('Punctuation', `.…,;:?!¡¿·•*/\\#(){}[]-–—_"'“”‘’«»‹›`, true) }}
		{{ glyphGroup('Symbols', `@&¶§%‰©®™°^|↑↓←→★$¢€£¥¤+−×÷=≠⁄<>≤≥±≈~∆∏∑∂µ`, true) }}
	</div>
</div>

<div id="features" class="specimen-sets">
	<h2 class="specimen-set-title">Features</h2>
	{{ for setKey, setInfo of setsList }}
	<h3 class="specimen-set-title">{{ setInfo.name }}</h3>
	{{ set glyphs = Array.isArray(setInfo.glyphs) ? setInfo.glyphs : setInfo.glyphs.split('') }}
	<div class="specimen-set-demo specimen-set-compare specimen">
		<span class="specimen-set-compare-before"{{ if setKey === 'dlig' }} style="--specimen-font-size-override: 0.625em;"{{ /if }}>
			{{ for loopIndex, glyph of glyphs }}
				{{ glyph }}
			{{ /for }}
		</span>
		<span class="specimen-set-compare-arrow">
			<span aria-hidden="true">&minus;</span>
			<span class="specimen-set-arrow-label">{{ setKey }}</span>
			<span aria-hidden="true">&rarr;</span>
		</span>
		<span class="specimen-set-compare-after specimen" data-features="{{ setKey }}">
			{{ for loopIndex, glyph of glyphs }}
				{{ glyph }}
			{{ /for }}
		</span>
	</div>
	{{ /for }}
</div>

<div class="font-samplers">
	<img src="./sampler-a.jpg" alt="" class="font-sampler-image" width="600" height="600" loading="lazy">
	<img src="./sampler-b.jpg" alt="" class="font-sampler-image" width="600" height="600" loading="lazy">
	<img src="./sampler-c.jpg" alt="" class="font-sampler-image" width="600" height="600" loading="lazy">
	<img src="./sampler-d.jpg" alt="" class="font-sampler-image" width="600" height="600" loading="lazy">
</div>


<h2>Acknowledgements</h2>
<p>I use the British English spelling everywhere, but since I live in the US, I am using US English spelling for the licence/license stuff, not that it makes much difference but I just want you to know, that I know, that it’s inconsistent of me.</p>
<p>Many thanks to Roel Nieskens for <a href="https://wakamaifondue.com/">wakamaifondue</a> to inspect my font files, which was super helpful to debug during development!</p>
<p>The visual materials for this font (samples, OpenGraph image) used photos from Unsplash by <a href="https://unsplash.com/photos/a-white-rectangular-object-with-a-screen-E1ZWQdhHO1w">molvin</a>, <a href="https://unsplash.com/photos/brown-wooden-framed-glass-door-DNameBYPLKo">sherloque</a>, <a href="https://unsplash.com/photos/black-and-white-ipad-case-zwKoA_0CWgg">onurbuz</a>, and <a href="https://unsplash.com/photos/a-desktop-computer-sitting-on-top-of-a-wooden-desk-PoL7eR-p4Z0">Marissa Lewis</a>.
</p>

<script>
{{ set fontSpecimenScript |> await jsmin(miniSiteSlug) -}}
document.addEventListener('DOMContentLoaded', function() {
	const glyphDetail = document.querySelector('.glyph-detail');
	const glyphDetailCode = glyphDetail.querySelector('.glyph-detail-code');
	const glyphDetailName = glyphDetail.querySelector('.glyph-detail-name');
	const glyphDetailInner = glyphDetail.querySelector('.glyph-detail-inner');

	function populateGlyphDetailMetadata({ codePoint, glyphName }) {
		if (glyphDetailCode) { glyphDetailCode.textContent = `U+${codePoint}`; }
		if (glyphDetailName) { glyphDetailName.textContent = glyphName; }
	}

	glyphDetail.addEventListener(glyphDetail.getAttribute('data-transition-event'), function (e) {
		const updateDom = () => {
			e.detail.executeUpdate();
			populateGlyphDetailMetadata(e.detail); // Should contain exactly what is expected: codePoint and glyphName
		}

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			updateDom();
			return;
		}
		
		glyphDetailInner.classList.add('is-changing');
		glyphDetailInner.addEventListener('animationend', () => { glyphDetailInner.classList.remove('is-changing'); }, { once: true });
		updateDom();
	})

	// On init, run with first selected glyph
	populateGlyphDetailMetadata({ ...glyphDetail.dataset });
	glyphDetail.removeAttribute('data-code-point');
	glyphDetail.removeAttribute('data-glyph-name');

	// Text preview modifier
	const testEditor = document.getElementById('test-editor');
	const pangrams = {{ fontPangrams |> JSON.stringify }};
	
	document.addEventListener('click', function(e) {
		if (!e.target || !e.target.closest) { return; }

		// If the user clicks in the inactive zone around the textarea, focus the input anyway
		const freetypeInputWrapper = e.target.matches('.freetype-input-wrapper') ? e.target : null;
		if (freetypeInputWrapper) {
			const freetypeInput = freetypeInputWrapper.querySelector('input, textarea');
			if (document.activeElement !== freetypeInput) {
				freetypeInput.focus();
			}
			return;
		}

		// Change the content
		const triggerButton = e.target.closest('[data-freetype-trigger]');
		if (triggerButton) {
			const triggerName = triggerButton.getAttribute('data-freetype-trigger');
			const currentText = testEditor.value.toUpperCase().trim();
			if (triggerName === 'pangram') {
				const currentPangram = triggerButton.hasOwnProperty('_currentPangram') ? triggerButton._currentPangram : -1;
				const nextPangram = [currentPangram + 1] % pangrams.length;
				triggerButton._currentPangram = nextPangram;
				testEditor.value = pangrams[nextPangram];
			}
			else if (triggerName === 'designs') {
				testEditor.value = `I <3 Cathode Ray Tube® Groove Stress 2.1 (START)`; // Showcases at least one of each font feature
			}
			else if (triggerName === 'uppercase') {
				testEditor.value = testEditor.value.toUpperCase();
			}
			else if (triggerName === 'lowercase') {
				testEditor.value = testEditor.value.toLowerCase();
			}
		}

		// Change the font features
		const toggleButton = e.target.closest('[data-freetype-toggle]');
		if (toggleButton) {
			const feature = toggleButton.getAttribute('data-freetype-toggle');
			const previewElement = testEditor.closest('[data-features]');
			const wasPressed = toggleButton.getAttribute('aria-pressed') === 'true';
			const isPressed = !wasPressed;

			toggleButton.setAttribute('aria-pressed', isPressed.toString());
			let activeFeatures = (previewElement.getAttribute('data-features') || '').split(' ').filter(Boolean);
			if (isPressed) { activeFeatures.push(feature); }
			else { activeFeatures = activeFeatures.filter(ft => ft !== feature); }
			previewElement.setAttribute('data-features', activeFeatures.join(' '));
		}
	});

	document.addEventListener('input', function(e) {
		if (!e.target || !e.target.closest) { return; }

		const slider = e.target.closest('[data-freetype-slider]');
		if (slider) {
			const targetAttr = slider.getAttribute('data-freetype-slider');
			const [sliderMin, sliderMax] = [slider.min, slider.max].map(n => parseInt(n, 10));
			const sliderValue = slider.valueAsNumber || (sliderMax + sliderMin / 2);
			const finalValue = Math.max(sliderMin, Math.min(sliderValue, sliderMax));
			testEditor.style.setProperty('--freeinput-size', `${finalValue}px`);
		}
	});
})
{{- /set }}
{{- fontSpecimenScript -}}
</script>
